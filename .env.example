XAI_API_KEY=
GROK_MODEL=grok-4.5
# Orcamento de IA por dia: o Python vigia de graca, o Grok so e chamado nos momentos que contam.
# Entradas e revisoes param no teto; as saidas de posicoes abertas tem reserva propria. Uso em data/grok_usage.json
# GROK_MAX_CALLS_PER_DAY=300
# GROK_EXIT_RESERVE_CALLS=100
# GROK_MAX_OUTPUT_TOKENS=400
# Binance: o Grok so e consultado a cada fecho de vela do AUTO_TIMEFRAME ou num evento (volume, RSI extremo, movimento brusco), no maximo 1 extra por vela e moeda
# EVENT_VOLUME_RATIO=2.0
# EVENT_RSI_LOW=25
# EVENT_RSI_HIGH=75
# EVENT_MOVE_ATR=1.5

# paper (simulado, por defeito) ou live (dinheiro real)
TRADING_MODE=live
# Em modo live, usa true para a testnet da Binance primeiro
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Limites de risco (aplicados no codigo, o Grok nao os pode contornar)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
MAX_ORDER_USDT=50
MAX_DAILY_LOSS_USDT=100
PAPER_START_USDT=1000
# Soma maxima de posicoes abertas
MAX_EXPOSURE_USDT=200
# Percentagem maxima da carteira que o bot pode usar (Binance e DEX). O resto fica livre para taxas da rede e outros custos.
# Na DEX, a ordem minima (DEX_MIN_SIZE_EUR) tem de caber nesta percentagem do orcamento, senao o bot nunca compra.
# WALLET_USE_PCT=95

# Modo automatico (arranca sempre desligado, liga-se na interface)
AUTO_INTERVAL_SEC=900
AUTO_MIN_CONFIDENCE=0.7
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10
COOLDOWN_SEC=3600
# true = o bot comeca a operar sozinho assim que arranca, sem clicar em nada
AUTO_START=true
# Sem isto o modo automatico recusa-se a ligar em live fora da testnet
AUTO_LIVE_ALLOWED=true

# --- DEX em dinheiro real (Solana). Deixa em paper ate testares em dry-run ---
# DEX_MODE=paper
# DEX_WALLET_KEY=
# DEX_LIVE_ARMED=false
# DEX_LIVE_DRY_RUN=true
# DEX_RPC_URL=https://api.mainnet-beta.solana.com
# DEX_DAILY_LOSS_EUR=10

# --- Tamanho de cada compra na DEX (em euros). O maximo tem de ser maior ou igual ao minimo,
# --- O orcamento nao e fixo: e WALLET_USE_PCT% do saldo da carteira (ja nao existe DEX_BUDGET_EUR) ---
# DEX_MIN_SIZE_EUR=2
# DEX_MAX_SIZE_EUR=5

# --- Alvo de lucro de cada compra na DEX (%): o Grok propoe e o codigo limita a [MIN, MAX]. O teto tambem vale para posicoes ja abertas ---
# DEX_TP_MIN_PCT=10
# DEX_TP_MAX_PCT=20
# DEX_TP_DEFAULT_PCT=15

# --- Stop-loss de cada compra na DEX: o Grok propoe e o codigo limita pela conviccao
# --- (confianca, tamanho e forca do volume de compra). Conviccao baixa fica entre MIN e SMALL_MAX;
# --- so a conviccao maxima chega ao teto MAX. Valores em % do resultado liquido ---
# DEX_STOP_MIN_PCT=5
# DEX_STOP_SMALL_MAX_PCT=10
# DEX_STOP_MAX_PCT=15

# --- Sinais de volume 5m/1h: acima destas subidas o preco conta como "esticado" e o bot nao persegue ---
# DEX_SURGE_MAX_M5_PCT=20
# DEX_SURGE_MAX_H1_PCT=150
